{
  "name": "neon-run-pc",
  "productName": "霓虹跑酷",
  "version": "1.9.2",
  "description": "霓虹跑酷 - PC 版桌面游戏",
  "main": "main.js",
  "author": "NeonRun",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "protect": "node tools/protect.js",
    "smoke": "electron tools/smoke-test.js build-protected",
    "predist": "npm run protect",
    "dist": "electron-builder --win portable",
    "predist:mac": "npm run protect",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.neonrun.pc",
    "productName": "霓虹跑酷",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "app": "build-protected"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "NeonRun-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "NeonRun-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "app/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "霓虹跑酷-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "electron-packager": "^17.1.2",
    "javascript-obfuscator": "^5.7.0"
  }
}
